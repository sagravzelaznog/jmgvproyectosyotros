# Configuración de Variables de Entorno
# Copia este archivo como .env.local para desarrollo

# 🔥 Firebase Configuration
# Obtén estos valores desde Firebase Console > Project Settings > General > Your apps
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789012
REACT_APP_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
REACT_APP_FIREBASE_MEASUREMENT_ID=G-ABCDEF1234

# 🤖 OpenAI API (Opcional - para tutor IA)
REACT_APP_OPENAI_API_KEY=your_openai_api_key_here

# 📊 GeoGebra API (Opcional - para visualizaciones avanzadas)
REACT_APP_GEOGEBRA_API_KEY=your_geogebra_api_key_here

# 🌐 Application URLs
REACT_APP_APP_URL=http://localhost:3000
REACT_APP_API_URL=https://your-api-domain.com/api

# 🔧 Development/Production Mode
NODE_ENV=development
GENERATE_SOURCEMAP=true

# 📱 PWA Configuration
REACT_APP_PWA_UPDATE_VIA_CACHE=auto

# 🔍 Analytics (solo producción)
REACT_APP_GA_TRACKING_ID=G-XXXXXXXXXX

# 📧 Email Configuration (para notificaciones)
REACT_APP_EMAILJS_SERVICE_ID=your_emailjs_service_id
REACT_APP_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
REACT_APP_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# 🚨 Error Reporting (Sentry - opcional)
REACT_APP_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# 🌍 Internationalization
REACT_APP_DEFAULT_LANGUAGE=es
REACT_APP_SUPPORTED_LANGUAGES=es,en,pt,fr

# ⚡ Performance Monitoring
REACT_APP_ENABLE_PERFORMANCE_MONITORING=true
REACT_APP_SLOW_QUERY_THRESHOLD=1000

# 🔒 Security
REACT_APP_ENABLE_CSP=true
REACT_APP_CSP_REPORT_URI=https://your-domain.com/csp-report

# 📱 Push Notifications (opcional)
REACT_APP_VAPID_KEY=your_vapid_public_key_here

# 💾 Cache Configuration
REACT_APP_CACHE_VERSION=1.0.0
REACT_APP_CACHE_MAX_AGE=3600000

# 🎯 Feature Flags
REACT_APP_ENABLE_AI_TUTOR=true
REACT_APP_ENABLE_COMMUNITY_FEATURES=true
REACT_APP_ENABLE_ADVANCED_VISUALIZATIONS=true
REACT_APP_ENABLE_GAMIFICATION=true
REACT_APP_ENABLE_OFFLINE_MODE=false

# 📊 Default Settings
REACT_APP_DEFAULT_DIFFICULTY=intermediate
REACT_APP_DEFAULT_THEME=light
REACT_APP_SESSION_TIMEOUT=3600000
REACT_APP_MAX_HINTS_PER_SESSION=3
REACT_APP_POINTS_PER_SESSION=100
REACT_APP_POINTS_PER_ACHIEVEMENT=50

# 🔧 Debug Options (solo desarrollo)
REACT_APP_DEBUG_MODE=false
REACT_APP_LOG_LEVEL=info
REACT_APP_ENABLE_REDUX_DEVTOOLS=true
REACT_APP_MOCK_API=false

---
# Configuración para Producción (.env.production)

NODE_ENV=production
GENERATE_SOURCEMAP=false
REACT_APP_APP_URL=https://calculus-integral-course.web.app
REACT_APP_API_URL=https://api.calculus-integral-course.com/v1
REACT_APP_ENABLE_PERFORMANCE_MONITORING=true
REACT_APP_DEBUG_MODE=false
REACT_APP_LOG_LEVEL=error
REACT_APP_ENABLE_REDUX_DEVTOOLS=false
REACT_APP_MOCK_API=false
